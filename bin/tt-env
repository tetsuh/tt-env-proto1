#!/usr/bin/env bash
# tt-env command dispatcher

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TT_ENV_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LIB_DIR="${TT_ENV_ROOT}/lib"
VERSION_FILE="${TT_ENV_ROOT}/VERSION"

# shellcheck disable=SC1091
source "${LIB_DIR}/core.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/install.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/version_manager.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/status.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/updater.sh"

usage() {
    cat <<'EOF'
tt-env - Tenstorrent Environment Manager

Usage:
  tt-env <command> [options]

Commands:
  install    Install a Tenstorrent stack release
  use        Switch the active Tenstorrent stack release
  list       List available and installed stack releases
  status     Show hardware and environment status
  update     Sync manifests and metadata
  help       Show this help message

Options:
  --help     Show this help message
  --version  Print tt-env version
EOF
}

print_version() {
    if [[ ! -f "$VERSION_FILE" ]]; then
        fail "VERSION file not found at ${VERSION_FILE}"
    fi

    local version
    version="$(<"$VERSION_FILE")"
    printf '%s\n' "$version"
}

run_placeholder() {
    local command_name="$1"
    log_info "${command_name} command is not implemented yet."
}

main() {
    local command="${1:-help}"

    case "$command" in
        --version)
            print_version
            ;;
        --help|-h|help)
            init_tt_home
            usage
            ;;
        install)
            init_tt_home
            shift || true
            install_release "$@"
            ;;
        use)
            init_tt_home
            shift || true
            use_release "$@"
            ;;
        status)
            init_tt_home
            shift || true
            status_show "$@"
            ;;
        list)
            init_tt_home
            shift || true
            list_releases "$@"
            ;;
        update)
            init_tt_home
            shift || true
            update_manifests "$@"
            ;;
        *)
            log_error "Unknown command: ${command}"
            usage >&2
            return 1
            ;;
    esac
}

main "$@"
