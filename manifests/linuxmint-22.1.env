# Manifest for Linux Mint 22.1
# Unofficial compatibility target based on Ubuntu 24.04 package mappings.

# Native Package Manager
PKG_MANAGER="apt"
USE_SYSTEM_PACKAGES="true"

# Required Repositories
# Official Tenstorrent apt repository. Linux Mint uses UBUNTU_CODENAME=noble.
REQUIRED_REPOS=(
  "https://ppa.tenstorrent.com/ubuntu/"
)

# Virtual Package Mappings
VIRT_PKG_CMAKE="cmake"
VIRT_PKG_NINJA="ninja-build"
VIRT_PKG_ZLIB="zlib1g-dev"
VIRT_PKG_KMD="tenstorrent-dkms"

# OS Specific Workarounds
WORKAROUNDS=()
